# --- Generated artefacts -------------------------------------------------
# orbis ships no data. Everything below is rebuilt locally by `start.sh` /
# `start.bat` (or by the Pages workflow) so that a fresh clone never inherits
# somebody else's calendar snapshot.
data/calendar.json
assets/land-dots.json
assets/borders.json
# The link preview, rendered from the live page at deploy time.
assets/social.png

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Editors and OS ------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# --- Secrets -------------------------------------------------------------
# orbis needs none of these: it has no API keys, no accounts and no config
# file. They are listed because a public fork is one `git add .` away from
# publishing a file somebody created out of habit, and that mistake cannot be
# taken back once it is pushed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.credentials
credentials.json
secrets.json
*.secret
.netrc
.npmrc
.pypirc
.aws/
.ssh/

# graft — local only. The graph cache is regenerable (`graft build`); the
# agent wiring is a personal setup choice, not a project requirement.
/graft/
.claude/
.mcp.json
.ignore
