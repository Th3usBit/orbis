# Normalise everything to LF inside the repository, whatever the contributor's OS.
* text=auto eol=lf

# Windows batch files are the exception: cmd.exe wants CRLF.
*.bat text eol=crlf

# Shell entry point must stay executable on a fresh clone.
start.sh text eol=lf

# Third-party, committed so the page needs no CDN. Not our code: keep it out of
# diffs and out of the repository's language statistics.
vendor/** linguist-vendored
vendor/three/*.min.js -diff
*.woff2 binary
